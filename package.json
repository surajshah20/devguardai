{
  "name": "devguard-ai",
  "version": "0.1.0",
  "description": "AI-powered GitHub Code Review & Bug Detection Agent",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=apps/api",
    "dev": "npm run dev --workspace=apps/api",
    "web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/api",
    "inspect": "node apps/api/bin/inspect-repo.js",
    "analyze": "node apps/api/bin/analyze-repo.js"
  },
  "keywords": [
    "code-review",
    "security",
    "static-analysis",
    "ai-agent",
    "github"
  ],
  "author": "",
  "license": "MIT"
}
