# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (Phase 4)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devguard

# GitHub Authentication & API
# For OAuth Web Flow:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
# Optional personal access token for local CLI testing without OAuth flow:
GITHUB_TOKEN=

# AI Provider Configuration ("gemini" or "ollama")
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434

